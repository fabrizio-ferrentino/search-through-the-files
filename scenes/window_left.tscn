[node name="Lontano" type="Node3D" parent="Esterno"]
editor_description = "Lo sfondo lontano (Quaternius, CC0): una catena di montagne contro il cielo (materiale unshaded scuro, appena piu' chiaro degli alberi e piu' scuro del cielo: fa da quinta) e due case lontane, BUIE (nessuna finestra accesa, nessuna luce). Davanti a Notte (z -15)."

