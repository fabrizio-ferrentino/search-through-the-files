[node name="SpotFinestra" type="Marker3D" parent="." groups=["enemy_spots", "spot_left"]]
editor_description = "Dove si affacciano Jester e HaloMan alla finestra: i PIEDI, fuori, sul prato. enemy_spots = il ThreatDirector lo usa come le porte del corridoio; spot_left = la zona e' la sinistra (la torcia va puntata da questa parte)."
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, -1.24, -0.75)

[node name="Esterno" type="Node3D" parent="."]
editor_description = "Il fuori visto dalla finestra (modelli di Quaternius, CC0: assets/textures/3d/outdoor/). Vicino uno steccato e due cespugli, poi due alberi secchi, in fondo un bosco di pini. Tutto DIETRO SpotFinestra (z -0.75), cosi' non copre chi si affaccia; Notte e Terreno sono stati allargati e allontanati per contenerli. Al buio si vedono appena; la torcia li illumina coi loro colori."

